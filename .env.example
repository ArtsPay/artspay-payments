# Shared ArtsPay sandbox credentials for local development across every
# example in this repo. Copy to `.env` at the repo root (gitignored) and fill
# in your real sandbox values — never live credentials.
#
# Each example still has its own `.env.example` and reads its own local
# `.env` first; this root file is only a fallback so you don't have to
# duplicate the same sandbox credentials into every example folder while
# working across several of them locally. It plays no part in how a client
# would actually use a single example folder on its own.

FZ_USERNAME=TESTyourusername
FZ_SHARED_SECRET=your-shared-secret
